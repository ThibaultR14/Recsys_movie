    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "match-report": "tsx scripts/match-report.ts",
    "reco-report": "tsx scripts/reco-report.ts",
    "reco-bench": "tsx scripts/reco-bench.ts"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "fflate": "^0.8.3",
    "fuse.js": "^7.5.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
